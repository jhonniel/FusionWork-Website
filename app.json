{
  "expo": {
    "name": "FUSION WORK",
    "slug": "fusionwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fusion-logo-transparent.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/fusion-logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#050816"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/fusion-logo-transparent.png",
        "backgroundColor": "#050816"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/fusion-logo-transparent.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font"
    ]
  }
}
